{
  "name": "parallax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test:experiments": "node --experimental-strip-types --test scripts/experiments.test.mjs",
    "predev": "node scripts/content.mjs",
    "prebuild": "node scripts/content.mjs",
    "validate:content": "node scripts/content.mjs",
    "typecheck:worker": "tsc -p workers/tutor/tsconfig.json",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/parallax-worker-check --config workers/tutor/wrangler.jsonc",
    "test": "node --experimental-strip-types --test scripts/experiments.test.mjs scripts/learning.test.mjs",
    "test:browser": "playwright test",
    "test:worker": "node --experimental-strip-types --test scripts/worker.test.mjs",
    "test:rules": "node --test scripts/firestore-rules.test.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261012.1-beta",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.4.1",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
