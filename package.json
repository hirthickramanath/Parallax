{
  "name": "parallax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test:experiments": "node --experimental-strip-types --test scripts/experiments.test.mjs",
    "predev": "node scripts/content.mjs && node scripts/foundation-revision-content.mjs",
    "prebuild": "node scripts/content.mjs && node scripts/foundation-revision-content.mjs",
    "validate:content": "node scripts/content.mjs && node scripts/foundation-revision-content.mjs",
    "typecheck:worker": "tsc -p workers/tutor/tsconfig.json",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/parallax-worker-check --config workers/tutor/wrangler.jsonc",
    "test": "node --experimental-strip-types --test scripts/chemistry-id-migration.test.mjs scripts/experiments.test.mjs scripts/learning.test.mjs scripts/stream.test.mjs scripts/lesson-examples.test.mjs scripts/foundation-expansion.test.mjs scripts/pilot-report.test.mjs scripts/broad-expansion.test.mjs scripts/review-evidence.test.mjs scripts/calculus-depth.test.mjs scripts/analysis-depth.test.mjs scripts/advanced-mechanics-depth.test.mjs scripts/analytical-mechanics-depth.test.mjs scripts/astro-depth.test.mjs scripts/multivariable-depth.test.mjs scripts/linear-ode-depth.test.mjs scripts/widget-artifacts.test.mjs scripts/em-depth.test.mjs scripts/thermal-optics-depth.test.mjs scripts/physical-chemistry-depth.test.mjs scripts/chemistry-depth.test.mjs scripts/advanced-math-depth.test.mjs scripts/structure-computing-foundation.test.mjs scripts/quantum-matter-fields.test.mjs scripts/review-delivery.test.mjs scripts/foundation-revision.test.mjs scripts/simulation-controls.test.mjs scripts/tutor-provider.test.mjs scripts/progress-backup.test.mjs scripts/learner-pilot.test.mjs scripts/course-investigations.test.mjs scripts/tutor-limiter.test.mjs scripts/security-headers.test.mjs scripts/numeric-verification.test.mjs scripts/tutor-eval.test.mjs scripts/verify-services.test.mjs scripts/theme-contrast.test.mjs",
    "test:browser": "playwright test",
    "test:worker": "node --experimental-strip-types --test scripts/worker.test.mjs",
    "test:rules": "node --test scripts/firestore-rules.test.mjs",
    "content:report": "node scripts/course-status.mjs",
    "test:assessment": "node --experimental-strip-types --test scripts/assessment.test.mjs",
    "typecheck:assessment": "tsc -p workers/assessment/tsconfig.json",
    "assessment:check": "wrangler deploy --dry-run --outdir /tmp/parallax-assessment-check --config workers/assessment/wrangler.jsonc",
    "test:reminders": "node --experimental-strip-types --test scripts/reminders.test.mjs",
    "typecheck:reminders": "tsc -p workers/reminders/tsconfig.json",
    "reminders:check": "wrangler deploy --dry-run --outdir /tmp/parallax-reminders-check --config workers/reminders/wrangler.jsonc",
    "content:audit": "node scripts/content-audit.mjs",
    "review:packet": "node scripts/review-packet.mjs",
    "review:handoff": "node scripts/review-handoff.mjs",
    "verify:public": "node scripts/public-deployment-check.mjs",
    "verify:numeric": "node scripts/verify-numeric.mjs",
    "verify:services": "node scripts/verify-services.mjs",
    "eval:tutor": "node scripts/tutor-eval.mjs",
    "review:audit": "node scripts/content-audit.mjs && node scripts/scientific-audit.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "jose": "^6.2.13",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261012.1-beta",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
